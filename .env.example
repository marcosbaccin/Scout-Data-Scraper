# Configurações do Banco de Dados
DATABASE_URL=sqlite:///scout.db
# DB_PATH=/caminho/para/scout.db

# Configurações de Scraping
HEADLESS=true
SCRAPER_RATE_LIMIT_DELAY=2.0

# =====================================================================================
# API / Dashboard — segurança
# =====================================================================================
# development (padrão): sem exigência de login, CORS apenas para localhost, /docs ligado.
# production: exige credenciais (ou ALLOW_PUBLIC=true), CORS só com ALLOWED_ORIGINS, /docs desligado.
APP_ENV=development

# Autenticação (use ao menos 16 caracteres em produção). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# API key: enviada em `X-API-Key: <chave>` ou `Authorization: Bearer <chave>` (scripts/integrações).
API_KEY=
# Basic Auth: o navegador pede usuário/senha uma vez e libera o dashboard inteiro.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Publicar SEM login (somente rate limit). Só tem efeito se nenhuma credencial estiver definida.
ALLOW_PUBLIC=false

# Origens permitidas no CORS, separadas por vírgula (sem barra final). Vazio em produção = nenhuma.
# Não é necessário se o dashboard é servido pela própria API (mesma origem).
ALLOWED_ORIGINS=

# Requisições por minuto por IP (0 desliga). O limite é por processo (WEB_CONCURRENCY).
RATE_LIMIT_PER_MIN=300

# Reativa /docs, /redoc e /openapi.json em produção.
# DOCS_ENABLED=true

# Defina true SOMENTE atrás de proxy reverso confiável (Caddy/Nginx) que sobrescreve X-Forwarded-For.
TRUST_PROXY=false

# Workers do uvicorn na imagem Docker (cada um carrega o dataset na memória).
WEB_CONCURRENCY=1
